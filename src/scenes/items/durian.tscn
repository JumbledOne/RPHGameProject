[sub_resource type="GDScript" id="GDScript_2kmxq"]
resource_name = "_durian"
script/source = "extends Area2D

func _physics_process(_delta: float) -> void:
	var player = GameManager.player
	if player == null or not overlaps_body(player):
		return
	if player.health >= player.max_health:
		return
	player.heal(1)
	$PowerupAudio.play_audio()
	$PowerupAudio.reparent(get_tree().current_scene, true)
	print(\"healed player, player health: \", player.health)
	queue_free()
"

