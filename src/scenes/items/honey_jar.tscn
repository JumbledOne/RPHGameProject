[sub_resource type="GDScript" id="GDScript_ykn7a"]
resource_name = "_honeyjar"
script/source = "extends Area2D

@export var tile_size: int = 16            # match your TileSet tile size
@export var field_tiles: int = 5           # field is 5 tiles wide
@export var slow_factor: float = 0.5         # enemies move at 50% speed
@export var field_duration: float = 0.0      # seconds, 0 = stays forever
@export var trigger_on_touch: bool = true
@export var trigger_on_hitbox: bool = true

@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var slow_field: Area2D = $SlowField

var activated: bool = false

func _ready() -> void:
	# Hold on frame 1 until triggered
	sprite.animation = \"default\"
	sprite.stop()
	sprite.frame = 0

	# Size the field in code: a circle 5 tiles across
	var shape: CircleShape2D = CircleShape2D.new()
	shape.radius = field_tiles * tile_size / 2.0
	$SlowField/CollisionShape2D.shape = shape
	slow_field.monitoring = false

	body_entered.connect(_on_body_entered)
	area_entered.connect(_on_area_entered)

func _on_body_entered(body: Node2D) -> void:
	if trigger_on_touch and body == GameManager.player:
		_activate()

func _on_area_entered(area: Area2D) -> void:
	if trigger_on_hitbox and area is Hitbox and area.owner_node == GameManager.player:
		_activate()

func _activate() -> void:
	if activated:
		return
	activated = true
	set_deferred(\"monitoring\", false)   # trigger is done
	sprite.play()

	slow_field.body_entered.connect(_apply_slow)
	slow_field.body_exited.connect(_release_slow)
	slow_field.set_deferred(\"monitoring\", true)

	if field_duration > 0.0:
		get_tree().create_timer(field_duration).timeout.connect(_end_field)

func _apply_slow(body: Node2D) -> void:
	if not body.is_in_group(\"enemy\"):
		return
	body.set_meta(\"slow_count\", body.get_meta(\"slow_count\", 0) + 1)
	body.set_meta(\"slow_multiplier\", slow_factor)

func _release_slow(body: Node2D) -> void:
	if not body.is_in_group(\"enemy\"):
		return
	var count: int = body.get_meta(\"slow_count\", 1) - 1
	body.set_meta(\"slow_count\", count)
	if count <= 0:
		body.set_meta(\"slow_multiplier\", 1.0)

func _end_field() -> void:
	slow_field.body_exited.disconnect(_release_slow)
	for body in slow_field.get_overlapping_bodies():
		_release_slow(body)
	slow_field.set_deferred(\"monitoring\", false)
"

