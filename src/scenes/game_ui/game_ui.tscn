[sub_resource type="GDScript" id="GDScript_3y7pu"]
resource_name = "_tracker"
script/source = "extends Label

func _ready() -> void:
	GameManager.collectibles_changed.connect(_update)
	_update(GameManager.collected, GameManager.total)

func _update(collected: int, total: int) -> void:
	text = \"%d/%d collected\" % [collected, total]
"

