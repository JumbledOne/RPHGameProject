[sub_resource type="GDScript" id="GDScript_8p81m"]
resource_name = "level_script"
script/source = "extends Node2D

func finish_level() -> void:
	$GameUi/ResultTable.text = GameManager.collectibles_summary()
	$GameUi/Gameoverlabel.show()
	$GameUi/ResultTable.show()
	$GameUi/CollectibleStats.hide()
	GameManager.game_end(GameManager.GameEnd.WON)
	
func _input(event: InputEvent) -> void:
	if not OS.is_debug_build():
		return
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_F1:
			finish_level()
"

